# Aether Gateway（relay-only）运行配置
# 安装时由 install.sh 复制到 /etc/aether/aether-gateway.env，权限 0640。
# 至少需要填写 AETHER_DATABASE_URL；密钥留空时安装脚本会自动生成。

ENVIRONMENT=production
TZ=Asia/Shanghai
RUST_LOG=info

# 监听端口
APP_PORT=8084

# 目录
AETHER_BASE_DIR=/opt/aether
AETHER_LOG_DIR=/opt/aether/logs
AETHER_GATEWAY_STATIC_DIR=/opt/aether/current/frontend

# 数据库（必填）
AETHER_DATABASE_DRIVER=postgres
AETHER_DATABASE_URL=postgres://aether:aether@127.0.0.1:5432/aether
DATABASE_URL=postgres://aether:aether@127.0.0.1:5432/aether

# 密钥（留空时 install.sh 会用 openssl 生成 43 字符随机串）
JWT_SECRET_KEY=
ENCRYPTION_KEY=

# 初始管理员（首次启动时创建）
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 日志
AETHER_LOG_DESTINATION=stdout
AETHER_LOG_FORMAT=pretty
AETHER_LOG_ROTATION=daily
AETHER_LOG_RETENTION_DAYS=7
AETHER_LOG_MAX_FILES=30

# 运行时
AETHER_RUNTIME_BACKEND=rust
AETHER_GATEWAY_DATABASE_MODE=auto
AETHER_UPDATE_STRATEGY=manual
API_KEY_PREFIX=sk-
